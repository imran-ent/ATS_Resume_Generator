# ─── Backend / AI Provider configuration ────────────────────────────────
# These variables are intended for a SERVER-SIDE backend only.
# NEVER prefix them with VITE_ — doing so exposes them to client JavaScript.

# Provider: "mock" | "openai" | "gemini"
AI_PROVIDER=mock

# Server-side secret. Do not commit real values.
AI_API_KEY=

AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# Optional backend base URL the frontend proxies AI requests to.
VITE_API_BASE_URL=/api