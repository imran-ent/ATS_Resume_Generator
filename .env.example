# ─── Backend / AI Provider configuration ────────────────────────────────
# These variables are read by the SERVERLESS FUNCTIONS in /api (server-side only).
# NEVER prefix them with VITE_ — doing so exposes them to client JavaScript.
#
# Where to get the values:
#   AI_PROVIDER : "openai" or "gemini" — which AI vendor you use.
#   AI_API_KEY  : OpenAI  -> https://platform.openai.com/api-keys  (sign in -> API keys -> Create new secret key)
#                 Gemini  -> https://aistudio.google.com/apikey   (sign in -> Create API key)
#   AI_MODEL    : OpenAI  -> e.g. gpt-4o-mini (cheap/fast) or gpt-4o
#                 Gemini  -> e.g. gemini-2.5-flash or gemini-2.5-flash-lite (free tier)
#   AI_MAX_TOKENS  : max response length, e.g. 2000
#   AI_TEMPERATURE : creativity 0.0–2.0, e.g. 0.7
#
# In the Vercel dashboard these go under Project Settings -> Environment Variables,
# scope them to "Production" and "Preview". They are server-only and never shipped
# to the browser.

AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.7

# ─── Client-side configuration (safe to expose, must be set at BUILD time) ──
# VITE_AI_MODE   : "mock" (no backend, demo AI) | "api" (use the /api functions above)
# VITE_AUTH_MODE : "none" (default) | "demo" (demo login demo@resumeforge.ai / demo)
# VITE_API_BASE_URL : where the client reaches the API. Same-origin Vercel functions
#                     live at "/api", so the default already works when deployed.

VITE_AI_MODE=mock
VITE_AUTH_MODE=none
VITE_API_BASE_URL=/api